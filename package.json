{
  "name": "fullstack-template",
  "version": "0.0.0",
  "private": true,
  "description": "Repository-level tooling only (git hooks, commit linting). App code lives in backend/ and frontend/.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "test:hooks": "node --test .claude/hooks/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2",
    "prettier": "3.9.10"
  }
}
