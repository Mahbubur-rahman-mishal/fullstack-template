# Normalise every text file to LF in the repository and working tree.
# Scripts run inside Linux containers break with CRLF line endings.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.jar  binary
*.zip  binary

# Generated files: collapse in GitHub diffs.
pnpm-lock.yaml linguist-generated=true
